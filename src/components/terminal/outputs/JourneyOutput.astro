---
import { portfolio } from '@/data/portfolio';
---

<ol class="console-output history-output" data-output-key="journey">
	{
		portfolio.journey.map((item) => (
			<li>
				<time>{item.period}</time>
				<div>
					<h3>{item.role}</h3>
					<p class="record-meta">
						{item.practice ? 'Prácticas / ' : ''}
						{item.place}
					</p>
					<p>{item.detail}</p>
				</div>
			</li>
		))
	}
</ol>
